[Unit]
Description=Marketplace Question Operator
After=network-online.target
[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/marketplace-question-operator
EnvironmentFile=/etc/marketplace-question-operator/secrets.env
# Hold this advisory lock across the daemon lifetime to prevent a second
# getUpdates consumer.
ExecStart=/usr/bin/flock -n /run/marketplace-question-operator.poller.lock /opt/marketplace-question-operator/.venv/bin/python -m app.daemon
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
