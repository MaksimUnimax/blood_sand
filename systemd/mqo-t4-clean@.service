[Unit]
Description=MQO clean isolated T4 acceptance (%i)
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/marketplace-question-operator
EnvironmentFile=/etc/marketplace-question-operator/secrets.env
ExecStart=/usr/bin/flock -n /run/marketplace-question-operator.poller.lock /opt/marketplace-question-operator/.venv/bin/python -m app.acceptance run --run-id %i
Restart=no
TimeoutStopSec=30
NoNewPrivileges=true
