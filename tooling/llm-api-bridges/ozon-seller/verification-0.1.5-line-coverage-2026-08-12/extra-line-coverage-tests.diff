+test('manual error-report builder failure marks claimed operation failed instead of leaving it active', async () => {
+  h.setFetchMode('throw');
+  const originalContract = global.OzonContract;
+  global.OzonContract = Object.freeze({
+    ...originalContract,
+    preflightExecution() { throw Object.assign(new Error('report builder exploded'), { code: 'REPORT_BUILD_X' }); }
+  });
+  try {
+    const r = await h.send({ type: 'OZ_EXECUTE_COMMAND', conversation_key: KEY, manual_request_id: 'm8b', command_text: 'OZON_API_V1 {"operation":"roles","params":{}}' });
+    assert.equal(r.ok, false);
+    assert.equal(r.code, 'REPORT_BUILD_X');
+    assert.equal(h.fetchCount, 1);
+    const op = h.store[h.KEYS.MANUAL_OPERATIONS][KEY];
+    assert.equal(op.status, 'failed');
+    assert.equal(op.last_error.code, 'REPORT_BUILD_X');
+  } finally {
+    global.OzonContract = originalContract;
+  }
+});
+
