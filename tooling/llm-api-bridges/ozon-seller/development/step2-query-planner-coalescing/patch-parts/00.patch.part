   const header = {
     bridge: "ozon-llm-api-bridge",
     version: VERSION,
     delivery_mode: "sequential_batch_single_delivery",
     result_count: reports.length,
-    capability_probe: capabilitySummary
+    capability_probe: capabilitySummary,
