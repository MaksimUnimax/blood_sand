    "/health/live": {
      "get": {
        "description": "Returns process liveness. A syntactically valid `x-request-id` header is preserved in the response; other values are replaced with a generated correlation ID.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "live"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Check process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Returns readiness of required infrastructure. A syntactically valid `x-request-id` header is preserved in the response; other values are replaced with a generated correlation ID.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "ready"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Default Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "enum": [
                            "INTERNAL_ERROR",
                            "INVALID_REQUEST",
                            "SERVICE_UNAVAILABLE",
                            "AUTH_RATE_LIMITED",
                            "AUTH_OTP_INVALID",
                            "AUTH_LOGIN_DENIED",
                            "AUTH_SESSION_INVALID",
                            "AUTH_CSRF_INVALID"
                          ],
                          "type": "string"
                        },
                        "correlationId": {
                          "maxLength": 128,
                          "minLength": 1,
                          "pattern": "^[A-Za-z0-9._:-]+$",
                          "type": "string"
                        },
                        "message": {
                          "minLength": 1,
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message",
                        "correlationId"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Check infrastructure readiness",
        "tags": [
          "health"
        ]
      }
    },
