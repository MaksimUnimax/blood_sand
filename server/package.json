{
  "name": "product-control-plane-server",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.34.5 <11"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && pnpm bridge:guard",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm bridge:guard",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "PRODUCT_CONTROL_PLANE_E2E=1 playwright test --config e2e/playwright.config.ts",
    "build": "pnpm --filter @product/api build && pnpm --filter @product/worker build && pnpm --filter @product/health-runner build && pnpm --filter @product/portal build && pnpm --filter @product/admin build",
    "db:generate": "pnpm --filter @product/db db:generate",
    "db:migrate": "pnpm --filter @product/db db:migrate",
    "api:dev": "pnpm --filter @product/api dev",
    "worker:dev": "pnpm --filter @product/worker dev",
    "bridge:guard": "node scripts/check-bridge-boundary.mjs",
    "openapi:generate": "pnpm --filter @product/api openapi:generate",
    "openapi:check": "pnpm --filter @product/api openapi:check",
    "format:check": "prettier --check \"{apps,packages,scripts,infra,integration}/**/*.{ts,tsx,js,mjs,cjs,json,css,scss,yml,yaml}\" package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs vitest.integration.config.ts ../.github/workflows/server-ci.yml"
  },
  "devDependencies": {
    "@product/auth": "workspace:*",
    "@product/db": "workspace:*",
    "@product/device-auth": "workspace:*",
    "@product/device-management": "workspace:*",
    "@product/extension-auth": "workspace:*",
    "@product/shared": "workspace:*",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.3.0",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.6"
  }
}
